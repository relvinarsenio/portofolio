{
	"name": "portofolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"build:all": "bun run format && bun run lint && bun run check && bun run build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"clean": "rm -rf .svelte-kit .wrangler build .output node_modules/.vite",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"node-html-parser": "^9.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"typst": "^0.10.0-8",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@fontsource-variable/inconsolata": "^5.3.0",
		"@iconify/svelte": "^5.2.2",
		"lucide-svelte": "^1.0.1",
		"svelte-meta-tags": "^5.0.2"
	}
}
